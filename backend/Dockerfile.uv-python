# Alternative Dockerfile using uv's Python management
FROM --platform=$BUILDPLATFORM ghcr.io/astral-sh/uv:python3.12-slim

# Create non-root user for OpenShift compatibility
RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash appuser

WORKDIR /app

# Copy requirements file first (for better Docker layer caching)
COPY requirements.txt .

# Create virtual environment and install dependencies in one step
RUN uv venv /app/.venv && \
    uv pip install -r requirements.txt

# Copy application files
COPY . .

# Create data directory and set permissions for OpenShift arbitrary UID support
RUN mkdir -p /app/data && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app

# Switch to non-root user
USER 1001

# Activate virtual environment
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

EXPOSE 8000

CMD ["python", "main.py"]